// Generated by gdc:scaffold-devcontainer
{
  "name": "SampleSPIService",

  // Attach a stable label so VS Code, IntelliJ, and CLI scripts can all locate the same
  // container via: docker ps --filter "label=devcontainer.repo=<repo-name>"
  "runArgs": ["--label", "devcontainer.repo=${localWorkspaceFolderBasename}"],

  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    // ── Infrastructure (always present) ──────────────────────────────────────
    "gdartifactory1.jfrog.io/docker-virt/gdcorp-commerce/code-atlas/stunt-doubles-core:latest": {},

    // ── AI agent commons (always present) ────────────────────────────────────
    "gdartifactory1.jfrog.io/docker-virt/gdcorp-commerce/code-atlas/devcontainer-commons:latest": {
      "agentContextPath": "/workspace/.devcontainer/agent/agents-devcontainer.md",
      "allowGitPush": true
      // ── Outbound network blocking ─────────────────────────────────────────
      // "blockedHosts": "api.godaddy.com"
    },

    // ── AI agents ─────────────────────────────────────────────────────────────
    "gdartifactory1.jfrog.io/docker-virt/gdcorp-commerce/code-atlas/claude-code:latest": {},

    // ── Language: Java (Gradle) ───────────────────────────────────────────────
    // Version is a guess — not declared anywhere in the repo. 17 is required by
    // Android Gradle Plugin 8.7 (used here) and supported by the Gradle 8.9 wrapper.
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installGradle": true
    },

    // ── GoDaddy Artifactory ────────────────────────────────────────────────────
    // root build.gradle and app/build.gradle both resolve dependencies from
    // GoDaddy's gradle-gdcorp-commerce-* and java-virt Artifactory repos.
    "gdartifactory1.jfrog.io/docker-virt/gdcorp-commerce/code-atlas/gd-artifactory:latest": {
      "configureGradle": true
    }

    // ── No stunt-doubles services wired ───────────────────────────────────────
    // This app has no detected HTTP/service dependencies to mock — it embeds
    // directly with the Poynt Android SDK as installed services, not a network client.
    // Re-run with explicit service names (e.g. `/gdc:scaffold-devcontainer authz`) to add one.
  },

  "remoteUser": "vscode",

  // ── Container-level env vars (available to ALL processes including Feature postStartCommands) ──
  "containerEnv": {
    "ARTIFACTORY_EMAIL": "${localEnv:ARTIFACTORY_EMAIL}",
    "ARTIFACTORY_TOKEN": "${localEnv:ARTIFACTORY_TOKEN}",
    "GOCODE_API_TOKEN": "${localEnv:GOCODE_API_TOKEN}",
    "GOCODE_BASE_URL": "${localEnv:GOCODE_BASE_URL}",

    // ── Atlassian MCP (optional) ──────────────────────────────────────────────
    "ATLASSIAN_USERNAME": "${localEnv:ATLASSIAN_USERNAME}",
    "ATLASSIAN_API_TOKEN": "${localEnv:ATLASSIAN_API_TOKEN}"
  },

  // ── Environment variables forwarded from host ─────────────────────────────
  "remoteEnv": {
    "GOCODE_API_TOKEN": "${localEnv:GOCODE_API_TOKEN}",
    "GOCODE_BASE_URL": "${localEnv:GOCODE_BASE_URL}",

    "GIT_TOKEN": "${localEnv:GIT_TOKEN}",
    "GIT_AUTHOR_NAME": "${localEnv:GIT_AUTHOR_NAME}",
    "GIT_AUTHOR_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}",

    "ARTIFACTORY_EMAIL": "${localEnv:ARTIFACTORY_EMAIL}",
    "ARTIFACTORY_TOKEN": "${localEnv:ARTIFACTORY_TOKEN}",

    // The app's own build files read these two directly for the "write" (publish)
    // Artifactory repos — alias them to the same Artifactory credentials.
    "ARTIFACTORY_WRITE_USERNAME": "${localEnv:ARTIFACTORY_EMAIL}",
    "ARTIFACTORY_WRITE_PASSWORD": "${localEnv:ARTIFACTORY_TOKEN}",
    "ARTIFACTORY_USERNAME": "${localEnv:ARTIFACTORY_EMAIL}",
    "ARTIFACTORY_PASSWORD": "${localEnv:ARTIFACTORY_TOKEN}"
  },

  // ── Workspace ─────────────────────────────────────────────────────────────
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",

  // ── initializeCommand ─────────────────────────────────────────────────────
  "initializeCommand": "mkdir -p ${localWorkspaceFolder}/.devcontainer/.agent-state/claude /tmp/atlas-worktree-git-unset",

  // ── Mounts ───────────────────────────────────────────────────────────────
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/.agent-state/claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:WORKTREE_GIT_DIR:/tmp/atlas-worktree-git-unset},target=${localEnv:WORKTREE_GIT_DIR:/tmp/atlas-worktree-git-unset},type=bind,consistency=cached"
  ],

  // No app port — this repo builds Android system services (SPI/Security SPI,
  // installed onto Poynt POS hardware), not a network listener. No stunt-doubles
  // services are wired either, so there are no observatory ports to forward.
  "forwardPorts": [],

  "portsAttributes": {},

  // ── IDE customizations ────────────────────────────────────────────────────
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropics.claude-code",
        "GitHub.copilot",
        "eamodio.gitlens",
        "GitHub.vscode-pull-request-github",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        "files.watcherExclude": {
          "**/node_modules/**": true,
          "**/.git/objects/**": true,
          "**/.git/subtree-cache/**": true
        }
      }
    },
    "jetbrains": {
      "plugins": ["com.anthropic.claude-code-jb"]
    }
  },

  "shutdownAction": "none"
}
